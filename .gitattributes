# Line endings are pinned so that a compiler running on the Linux intel server and a
# developer on Windows produce byte-identical output. Without this, "byte-for-byte
# identical" is not a well-defined property: core.autocrlf makes it platform-dependent.
#
# The removal scripts target Windows and are served directly to end users, so they keep
# CRLF in the working tree. Git still stores LF in the object database.

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

.gitattributes text eol=lf
