# Copy to deploy/.env on the server and fill in. NEVER commit the filled copy.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# Every value here is empty on purpose. An example file with a plausible-looking key is how a
# real one eventually gets committed by someone in a hurry.
#
# None of these belong on a SOC machine. This file lives on the external factory host only.

# ---------------------------------------------------------------------------
# Hybrid Analysis -- READ ONLY. Vetted key required.
# The client cannot submit or upload: it has no request body. Leave empty to stay in fixture
# mode, which needs no key and reaches nothing.
# ---------------------------------------------------------------------------
HYBRID_ANALYSIS_API_KEY=
HYBRID_ANALYSIS_BASE_URL=https://www.hybrid-analysis.com/api/v2

# ---------------------------------------------------------------------------
# Triage -- optional, off by default, and the pipeline is specified to work entirely without
# it. Setting TRIAGE_ENABLED=true with an empty key is refused at startup rather than silently
# degraded.
# ---------------------------------------------------------------------------
TRIAGE_ENABLED=false
TRIAGE_API_KEY=

# ---------------------------------------------------------------------------
# Model. Leave LLM_ENABLED false to use the deterministic fake: free, offline, reproducible,
# and the default everywhere including CI.
# LLM_PROVIDER: anthropic | openai-compatible
# ---------------------------------------------------------------------------
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Storage and retention. DATA_DIR is set by compose and should not be set here.
# ---------------------------------------------------------------------------
RAW_PUBLIC_RETENTION_DAYS=30
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Publication is NOT done from this host. No GITHUB_TOKEN belongs in this file: the machine
# holding the provider keys must not also hold a write credential for the repository.
# ---------------------------------------------------------------------------
